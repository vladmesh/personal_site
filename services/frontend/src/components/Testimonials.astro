---
import type { TestimonialEntry } from '@lib/profile/full';
const { testimonials = [], lang = 'en', title, tabs } = Astro.props as {
  testimonials: TestimonialEntry[];
  lang: 'en' | 'ru';
  title?: string;
  tabs?: { dev: string; teacher: string };
};

const labels = {
  dev: tabs?.dev ?? (lang === 'ru' ? 'Разработчик' : 'Developer'),
  teacher: tabs?.teacher ?? (lang === 'ru' ? 'Преподаватель' : 'Mentor'),
};

// Keep a stable order (dev, then teacher) and drop empty kinds. With a single
// populated kind the section renders as a plain block; with two it gets tabs.
const groups = (['dev', 'teacher'] as const)
  .map((kind) => ({ kind, label: labels[kind], items: testimonials.filter((t) => t.kind === kind) }))
  .filter((group) => group.items.length > 0);

const multi = groups.length > 1;
const requested = Astro.url.searchParams.get('t');
const active = multi && groups.some((g) => g.kind === requested) ? requested : groups[0]?.kind;
---
<section id="testimonials" class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-3xl font-semibold text-white">{title ?? (lang === 'ru' ? 'Отзывы' : 'Testimonials')}</h2>
    {multi && (
      <div class="flex gap-2 rounded-full border border-white/10 bg-white/5 p-1 text-sm">
        {groups.map((group) => (
          <a
            href={`?t=${group.kind}`}
            data-tab={group.kind}
            role="button"
            aria-pressed={active === group.kind ? 'true' : 'false'}
            class={`rounded-full px-3 py-1 ${active === group.kind ? 'bg-brand text-white' : 'text-slate-300 hover:text-white'}`}
          >
            {group.label}
          </a>
        ))}
      </div>
    )}
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    {groups.map((group) => group.items.map((item) => (
      <figure data-kind={group.kind} class={`rounded-2xl border border-white/10 bg-white/5 p-5 ${multi && active !== group.kind ? 'hidden' : ''}`} key={item.quote[lang]}>
        <blockquote class="text-slate-100">“{item.quote[lang]}”</blockquote>
        <figcaption class="mt-3 text-sm text-slate-400">
          {item.author}
          {item.role ? (
            <span class="text-slate-500"> · {item.role}</span>
          ) : null}
          {item.url ? (
            <a href={item.url} target="_blank" rel="noreferrer" class="ml-2 text-brand-light hover:text-brand">{lang === 'ru' ? 'Источник' : 'Source'}</a>
          ) : null}
        </figcaption>
      </figure>
    )))}
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('section#testimonials');
      if (!root) return;
      const tabButtons = root.querySelectorAll('[data-tab]');
      // Single-kind block: no tabs, nothing to toggle.
      if (tabButtons.length === 0) return;
      const cards = root.querySelectorAll('[data-kind]');

      function setActive(kind) {
        tabButtons.forEach((el) => {
          const key = el.getAttribute('data-tab');
          if (key === kind) {
            el.classList.add('bg-brand', 'text-white');
            el.classList.remove('text-slate-300', 'hover:text-white');
            el.setAttribute('aria-pressed', 'true');
          } else {
            el.classList.remove('bg-brand', 'text-white');
            el.classList.add('text-slate-300', 'hover:text-white');
            el.setAttribute('aria-pressed', 'false');
          }
        });

        cards.forEach((el) => {
          const k = el.getAttribute('data-kind');
          el.classList.toggle('hidden', k !== kind);
        });

        const url = new URL(window.location.href);
        url.searchParams.set('t', kind);
        history.replaceState({}, '', url);
      }

      tabButtons.forEach((el) => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          setActive(el.getAttribute('data-tab') || tabButtons[0].getAttribute('data-tab'));
        });
      });

      const requested = new URL(window.location.href).searchParams.get('t');
      const known = Array.from(tabButtons).map((el) => el.getAttribute('data-tab'));
      setActive(known.includes(requested) ? requested : known[0]);
    })();
  </script>
</section>
