---
const { lang = 'en', copy, showOffer = false } = Astro.props as {
  lang: 'en' | 'ru';
  showOffer?: boolean;
  copy: {
    brand: string;
    nav: { offer: string; projects: string; skills: string; testimonials: string; contact: string };
  };
};
const rest = Astro.url.pathname.replace(/^\/(ru|en)/, '') || '/';
const toggledPath = `/${lang === 'ru' ? 'en' : 'ru'}${rest}`;
const otherLang = lang === 'ru' ? 'en' : 'ru';

const links = [
  ...(showOffer ? [{ href: `/${lang}/#offer`, label: copy.nav.offer }] : []),
  { href: `/${lang}/#projects`, label: copy.nav.projects },
  { href: `/${lang}/#skills`, label: copy.nav.skills },
  { href: `/${lang}/#testimonials`, label: copy.nav.testimonials },
  { href: `/${lang}/#contact`, label: copy.nav.contact }
];

const langPill =
  'rounded-full border border-white/20 px-3 py-1 text-xs uppercase tracking-wider text-white no-underline transition hover:border-white/60';
---
<header class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href={`/${lang}/`} class="shrink-0 text-lg font-semibold tracking-tight text-white no-underline">{copy.brand}</a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-slate-200 md:flex">
      {links.map((l) => <a href={l.href} class="no-underline hover:text-white">{l.label}</a>)}
      <a href={toggledPath} class={langPill}>{otherLang}</a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a href={toggledPath} class={langPill}>{otherLang}</a>
      <button
        id="nav-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-white/20 bg-transparent p-0 text-white"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-white/10 px-4 pb-3 pt-1 sm:px-6 md:hidden">
    {links.map((l) => (
      <a href={l.href} class="block py-2 text-base font-medium text-slate-200 no-underline hover:text-white">{l.label}</a>
    ))}
  </nav>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menu.classList.add('hidden');
  });
</script>
