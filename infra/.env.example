# Example .env file for development
# Copy this to .env and fill in the values

# PostgreSQL
POSTGRES_DB=personal_site
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Backend
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:4321

# Admin panel (sqladmin)
ADMIN_USERNAME=admin
# PBKDF2 hash of the password, NOT the password itself. Generate with:
#   cd services/backend && python -m app.security '<your password>'
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$change_me
ADMIN_SECRET_KEY=change_me_long_random

# Production deploy (docker-compose.prod.yml)
# Public domain Caddy serves and gets a Let's Encrypt cert for.
SITE_DOMAIN=localhost
# Owner of the ghcr images (your GitHub login, lowercase).
REGISTRY_OWNER=your-github-login
