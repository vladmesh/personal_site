# Internal Caddy for infra/docker-compose.tunnel.yml. Plain HTTP on :8080: TLS ends at Cloudflare,
# and cloudflared forwards the tunnel to caddy:8080.
:8080 {
  encode zstd gzip

  # CV files are served straight from the ~/personal_site/cv bind mount, bypassing the SSR frontend.
  handle_path /cv/* {
    root * /srv/cv
    file_server
  }

  handle /admin* {
    reverse_proxy backend:8000
  }

  handle /api* {
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy frontend:4321
  }

  header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  header X-Content-Type-Options "nosniff"
  header Referrer-Policy "strict-origin-when-cross-origin"
}
